# =============================================================
# AI Fashion Shop - 환경변수 템플릿
# Claude Code on the web에서 새 VM 생성 시 이 파일을 참고합니다.
# 사용법: cp .env.example ai-fashion-shop/.env.local
# 그 후 각 값을 실제 시크릿으로 교체하세요.
# =============================================================

# ─── Supabase (데이터베이스 + 인증) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Google Vertex AI (AI 이미지/비디오 생성) ───
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary (이미지 호스팅/CDN) ───
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=product_images

# ─── PortOne (PG 결제) ───
NEXT_PUBLIC_PORTONE_STORE_ID=store-your-store-id
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-your-channel-key
PORTONE_API_SECRET=your-portone-api-secret

# ─── Telegram (주문 알림 봇) ───
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ─── 외부 Cron 인증 ───
CRON_SECRET=your-cron-secret

# ─── 네이버 소셜 로그인 ───
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ─── 비즈니스 정보 ───
NEXT_PUBLIC_CONTACT_PHONE=010-0000-0000
ADMIN_BANK_NAME=은행명
ADMIN_BANK_ACCOUNT=000-0000-0000-00
ADMIN_BANK_HOLDER=예금주명
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-id
